# Ignore all compiled .lisp files ('fasl' stands for fast loading).
*.fasl

# manual.texi is updated on every commit. Changes are already committed in
# manual.html.
/assets/reference-manual.texi

# Ignore all HTML files. manual.html and project-isidore-doc.html contain
# duplicates of the source code.
/assets/blog/project-isidore-doc.html

# Ignore the 'bin' subfolder generated by '(asdf:make "project-isidore")'
/bin/

# Ignore the 'lib' subfolder generated by 'make.lisp'
system-index.txt
/lib/*
# Except the two vendored files
!/lib/bootstrap-quicklisp.lisp
!/lib/upgrade-asdf.lisp

# Ignore claude files.
/.claude/
