# Ignore all compiled .lisp files ('fasl' stands for fast loading).
*.fasl

# Ignore the 'bin' subfolder generated by '(asdf:make "project-isidore")'
/bin/

# Ignore the ocicl-fetched systems directory. ocicl.csv at the project root
# is committed; sources are re-fetched on demand from sha256-pinned digests.
/ocicl/

# Ignore claude files.
/.claude/
