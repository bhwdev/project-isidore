#
# Deploy hook on the production host, installed as
# /usr/local/sbin/project-isidore-deploy and run as the forced command of the
# deploy key in /root/.ssh/authorized_keys:
#
#   restrict,command="/usr/local/sbin/project-isidore-deploy" ssh-ed25519 AAAA... project-isidore-deploy
#
# .github/workflows/deploy.yml runs `ssh root@HOST IMAGE@DIGEST'; sshd passes
# that to this script in SSH_ORIGINAL_COMMAND instead of running it, so the
# key can do nothing but run an image of this repository, by digest, under
# the Quadlet unit (deploy/project-isidore.container, installed by hand).
set -eu

image=${SSH_ORIGINAL_COMMAND:-}
digest=${image#ghcr.io/bhwdev/project-isidore@sha256:}
case $digest in
    "$image" | *[!0-9a-f]*)
        echo "usage: ghcr.io/bhwdev/project-isidore@sha256:<64 hex digits>" >&2
        exit 64 ;;
esac
if [ ${#digest} -ne 64 ]; then
    echo "usage: ghcr.io/bhwdev/project-isidore@sha256:<64 hex digits>" >&2
    exit 64
fi

podman pull --quiet "$image"
podman tag "$image" localhost/project-isidore:latest
systemctl restart project-isidore.service
# The image the restart replaced is now untagged.
podman image prune --force > /dev/null
systemctl is-active project-isidore.service
