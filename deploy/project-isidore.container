#
# Podman Quadlet unit for the image .github/workflows/deploy.yml builds from
# guix.scm.  Installed by hand (README.org, "Deployment") as
# /etc/containers/systemd/project-isidore.container, from which systemd
# generates project-isidore.service (journalctl -u project-isidore keeps
# working); deploy/project-isidore-deploy tags each deployed image as below.

[Unit]
Description=Project Isidore web application.
After=network-online.target llama-server.service
Wants=network-online.target llama-server.service

[Container]
Image=localhost/project-isidore:latest
# The deploy hook pulls the image by digest; starting the unit never pulls.
Pull=never
ContainerName=project-isidore
# Hunchentoot (127.0.0.1:8080, proxied by Caddy), Slynk (127.0.0.1:4005) and
# llama-server (127.0.0.1:8081) all use the host's loopback interface.
Network=host
# SBCL as PID 1 would not reap children; catatonit does, and forwards SIGTERM.
RunInit=true
Environment=VAN_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
Environment=PROJECT_ISIDORE_DATA=/var/lib/project-isidore/
# The pack links these into place (see .github/workflows/deploy.yml).
Environment=SSL_CERT_DIR=/etc/ssl/certs
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
Environment=TZDIR=/usr/share/zoneinfo
Environment=TZ=America/Toronto
# An empty VAN_LLM_URL= here turns the model fallback off without a deploy.
EnvironmentFile=/usr/local/etc/project-isidore/secrets.env
# Bible graph-db and Montezuma index, read when the application starts.
Volume=/var/local/project-isidore:/var/local/project-isidore
# The CRUD graph-db (Slack subscriptions and identities).  Before the move to
# a container the service ran as root without PROJECT_ISIDORE_DATA, so it
# lives under root's $XDG_DATA_HOME.
Volume=/root/.local/share/project-isidore:/var/lib/project-isidore

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
